# Multi-Agent Orchestration - Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required for real LLM calls)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use (default: Claude 3.5 Sonnet)
# Options: anthropic:claude-3-5-sonnet-20241022, anthropic:claude-3-5-haiku-20241022, etc.
LLM_MODEL=anthropic:claude-3-5-sonnet-20241022

# Agent Configuration
MAX_TURNS=10
ENABLE_HUMAN_IN_LOOP=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json